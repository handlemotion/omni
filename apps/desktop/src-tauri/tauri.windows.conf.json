{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "Omni",
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": { "installMode": "quiet" }
    }
  }
}
