# Omni Desktop build config (ADR 0043, docs/spec/desktop.md "Build, signing, release").
# Read at build time. Nothing here is a secret; signing credentials live in CI only.

# The Omni server a hosted build opens on first run. Leave empty for a build that asks.
OMNI_DESKTOP_ORIGIN=

# Bundle identifier, shown as "Omni". Permanent once installed.
OMNI_DESKTOP_BUNDLE_ID=app.omnidirectional.desktop
# App group the app and the File Provider extension share (macOS).
OMNI_DESKTOP_APP_GROUP=group.app.omnidirectional.desktop
# Apple Developer team that signs the macOS app and extension.
APPLE_TEAM_ID=

# Updates (docs/spec/desktop.md "Updates"). The minisign public key releases are signed with
# (`tauri signer generate`); a build without it never checks. The feed defaults to the chosen
# server's /desktop/latest.json; set an absolute URL to use another.
OMNI_DESKTOP_UPDATER_PUBKEY=
OMNI_DESKTOP_UPDATER_ENDPOINT=
