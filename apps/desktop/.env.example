# Omni Desktop build config (docs/spec/desktop.md "Build, signing, release").
# Read at build time. Nothing here is a secret: signing keys are files, named by path.

# The Omni server a hosted build opens on first run. Leave empty for a build that asks.
OMNI_DESKTOP_ORIGIN=

# Bundle identifier, shown as "Omni". Permanent once installed.
OMNI_DESKTOP_BUNDLE_ID=app.omnidirectional.desktop
# App group the app and the File Provider extension share (macOS).
OMNI_DESKTOP_APP_GROUP=group.app.omnidirectional.desktop
# Apple Developer team that signs the macOS app and extension.
APPLE_TEAM_ID=

# Updates (docs/spec/desktop.md "Updates"). The minisign public key releases are signed with
# (`tauri signer generate`); a build without it never checks. The feed defaults to the chosen
# server's /desktop/latest.json; set an absolute URL to use another.
OMNI_DESKTOP_UPDATER_PUBKEY=
OMNI_DESKTOP_UPDATER_ENDPOINT=

# Releases (scripts/release-macos.sh, run on a Mac). Copy to apps/desktop/.env. Each key stays a
# file on that Mac; these only name it. OMNI_DESKTOP_ORIGIN above is also where releases are
# served from (<origin>/desktop/latest.json), so a release build must set it.
# The Developer ID identity, as `security find-identity -v -p codesigning` lists it.
APPLE_SIGNING_IDENTITY=
# Developer ID provisioning profiles for the app and for <bundle id>.fileprovider.
OMNI_APP_PROFILE=
OMNI_EXTENSION_PROFILE=
# App Store Connect API key for notarization: its key ID, issuer ID, and the .p8 file.
APPLE_API_KEY=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=
# The updater's private key (`pnpm --filter @omni/desktop tauri signer generate -w <path>`); its
# public half is read from <path>.pub. Lose it and installed apps can never update again: back
# it up. TAURI_SIGNING_PRIVATE_KEY_PASSWORD if it has one.
TAURI_SIGNING_PRIVATE_KEY_PATH=
# The R2 bucket the Worker binds as DESKTOP_BUCKET. Uploads use CLOUDFLARE_API_TOKEN and
# CLOUDFLARE_ACCOUNT_ID from the environment.
OMNI_DESKTOP_RELEASE_BUCKET=omni-desktop
