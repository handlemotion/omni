# Dev only: where `pnpm dev` forwards /api (Hono API, Better Auth, realtime websocket).
# Defaults to `wrangler dev` on http://localhost:8787. The built app needs no config: the
# Worker serves it on the same origin as the API.
OMNI_API_ORIGIN=

# Optional: Sentry for the browser. Unset keeps error reporting off. The DSN ships in the bundle
# (Sentry DSNs are public by design), so it is read at build time. Events are scrubbed of mail
# content, addresses, credentials and query strings before they are sent.
VITE_SENTRY_DSN=
# Sentry environment tag; defaults to production.
VITE_SENTRY_ENVIRONMENT=
# Optional: upload source maps to Sentry during `vite build` and delete them from dist/ after.
# All three are needed. SENTRY_AUTH_TOKEN is a credential: inject it, never commit it.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
