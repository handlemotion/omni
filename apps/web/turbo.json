{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:e2e": {
      // Run after the Worker's suite: under its parallel load, connectivity's restart test finds the
      // open thread not refetched after the socket reconnects (an app-side timing bug). The
      // shared Worker build no longer rewrites `dist/` per start (apps/worker/e2e/global-setup.ts).
      "dependsOn": ["@omni/worker#test:e2e"]
    }
  }
}
