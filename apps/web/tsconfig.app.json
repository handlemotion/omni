{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".tsbuild/app",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  // The Worker's route types reach the app through `@omni/client`.
  "references": [{ "path": "../../packages/client/tsconfig.src.json" }]
}
