# apps/worker local config. Copy to `.dev.vars` (read by `wrangler dev`); in production set vars
# in wrangler.jsonc or the dashboard and secrets with `wrangler secret put <NAME>`.
# Hyperdrive needs no variable locally: wrangler.jsonc's `localConnectionString` points at the
# local stack's Postgres. Override it with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.

# --- Auth (Better Auth; see packages/auth/.env.example) ---
# Secret. At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this Worker (serves /api/auth).
BETTER_AUTH_URL=http://localhost:8787
# Comma-separated web/app origins allowed to call auth endpoints. `omni://` lets the iOS and
# desktop apps finish a magic-link sign-in (the link ends on that scheme).
AUTH_TRUSTED_ORIGINS=http://localhost:5173,omni://
# Optional. WebAuthn relying party ID; defaults to the BETTER_AUTH_URL host.
AUTH_PASSKEY_RP_ID=
# Optional. Name shown in passkey prompts and magic-link mail. Defaults to "Omni".
APP_NAME=Omni
# Optional. Web app origin; invitation emails link to <WEB_APP_URL>/invite/<id>. Defaults to
# BETTER_AUTH_URL (the Worker serves the web app on the same origin). Locally, Vite's origin.
WEB_APP_URL=http://localhost:5173
# Optional. Google OAuth client ("Web application" type, Google Cloud console). Set both to show
# "Sign in with Google" and let members connect a Gmail account; leave both empty to hide both.
# Authorized redirect URIs: <BETTER_AUTH_URL>/api/auth/callback/google (sign-in) and
# <BETTER_AUTH_URL>/api/connect/google/callback (connecting Gmail).
GOOGLE_CLIENT_ID=
# Secret.
GOOGLE_CLIENT_SECRET=
# Optional. "off" connects Gmail without asking for its Google Calendar
# (calendar.events.readonly), so a connected account's calendar does not show. On by default; it
# needs the Google Calendar API enabled in the client's Google Cloud project.
GOOGLE_CALENDAR=
# Optional. Who may sign up: "open" (default: anyone with a verified email signs up and
# creates their own workspace in onboarding) or "invitation" (a private install: sign-up needs a
# pending invitation, and only owners create workspaces; the first comes from
# `pnpm --filter @omni/db org:create`).
SIGN_UP=
# Optional: hosts whose OAuth client metadata documents agents may connect with over MCP,
# comma separated. Empty: Claude's and ChatGPT's (claude.ai, chatgpt.com). Other
# MCP clients register dynamically.
MCP_CIMD_HOSTS=

# --- Mail service ---
# Base URL of apps/mail. The Worker pings it after writing to the outbox.
MAIL_SERVICE_URL=http://localhost:8788
# Secret. Signs Worker <-> mail service calls; same value as the mail service's.
# Generate: openssl rand -hex 32
MAIL_SERVICE_HMAC_SECRET=
# Address magic links, invitations and notices come from, sent with Cloudflare Email Sending
# (its domain onboarded there; `wrangler dev` only simulates it). Leave empty to disable email sign-in.
SYSTEM_MAIL_FROM=

# Optional. iOS apps that open this host's Drive share links (/s/<id>), as <team id>.<bundle id>,
# comma-separated. Served at /.well-known/apple-app-site-association. Empty: none.
IOS_APP_IDS=

# Optional. Largest file one upload may stage for a send, in bytes. Empty: 26214400 (25 MB).
UPLOAD_MAX_BYTES=

# --- Storage (the STORAGE_BUCKET binding in wrangler.jsonc) ---
# Optional. Largest file Storage accepts, in bytes. Empty: 107374182400 (100 GB).
STORAGE_MAX_FILE_BYTES=
# Optional. Largest upload whose declared sha256 is checked against the bytes. Empty: 8 GB.
STORAGE_HASH_CHECK_MAX_BYTES=
# Optional. Uploads one person may have in progress in a workspace. Empty: 500.
STORAGE_MAX_OPEN_UPLOADS=
# Optional. Bytes one person's uploads in progress may hold in a workspace. Empty: 1 TB.
STORAGE_MAX_RESERVED_BYTES=
# Optional. Ceiling on what any one workspace may store, in GB. Empty: none.
STORAGE_MAX_GB=

# --- Live co-editing (S2, or s2-lite from compose.yml) ---
# Optional. The basin's API base, ending in /v1. Empty: documents edit with checked saves only.
# Local stack: http://localhost:54380/v1
S2_BASIN_URL=
# Optional (required with S2_BASIN_URL). The basin's name. Local stack: omni-docs-dev
S2_BASIN=
# Secret. An S2 access token for the basin's streams. s2-lite accepts any value.
S2_ACCESS_TOKEN=

# --- AI ---
# Secret. Triage when TYPESAFE_API_KEY is empty. With neither key, threads stay
# unsorted (only a wordless reply from you files itself, as FYI).
ANTHROPIC_API_KEY=
# Optional. Model API base URL, for a proxy or gateway. Defaults to Anthropic's.
ANTHROPIC_BASE_URL=
# Optional. "off" stops Drive reading text in pictures and scanned PDFs with the model. With
# ANTHROPIC_API_KEY set it is on: up to 8 files a minute on Claude Haiku, 1-2k tokens a page or picture.
DRIVE_OCR=

# --- Meetings ---
# Optional. The transcription engine: "assemblyai" (speakers labelled and named), "openai" (any
# OpenAI-compatible /audio/transcriptions server), "workers-ai" (the AI binding, no speakers) or
# "none" (the default: Meetings is off). docs/spec/meetings.md, "Transcription". "workers-ai"
# also needs "ai": { "binding": "AI" } in wrangler.jsonc; without it Meetings stays off.
TRANSCRIBE_PROVIDER=
# Optional. The engine's base URL: AssemblyAI's EU host, or the OpenAI-compatible server.
TRANSCRIBE_URL=
# Optional. The engine's model, e.g. whisper-1 on an OpenAI-compatible server.
TRANSCRIBE_MODEL=
# Secret. The engine's API key, for assemblyai and for a server that asks for one.
TRANSCRIBE_API_KEY=
# Secret. TypeSafe key: triage runs on Jev when set, and mail and Drive search
# results are reordered by Jev's relevance judgment (Drive also finds files by meaning). Empty: search keeps full-text order.
TYPESAFE_API_KEY=
# Optional. "jev" or "claude"; defaults to Jev when TYPESAFE_API_KEY is set.
TRIAGE_PROVIDER=
# Optional. Jev model override.
JEV_MODEL=
# Optional. TypeSafe API base URL. Defaults to https://api.typesafe.ai.
TYPESAFE_API_URL=

# --- Billing (optional; docs/self-hosting.md "Billing") ---
# Leave STRIPE_SECRET_KEY empty for no billing: no plan, no limits. Set it (test mode, sk_test_...)
# and the three marked "required" below must be set too, or the Worker will not start.
# Optional. "off" turns billing off even with the Stripe settings below set (they stay unchecked).
BILLING=
# Secret. Stripe secret key.
STRIPE_SECRET_KEY=
# Secret, required. Signing secret of the webhook endpoint (locally: `stripe listen` prints it).
STRIPE_WEBHOOK_SECRET=
# Required. Price id of the Team plan's monthly price. Amounts are set in Stripe, not here; what
# each plan allows is PLAN_LIMITS in packages/contracts/src/plans.ts.
STRIPE_PRICE_MONTHLY=
# Optional. Price id of Team's yearly price. Empty offers Team monthly only.
STRIPE_PRICE_YEARLY=
# Optional. Price ids of the Business plan (its own Stripe product). Empty monthly: Business is not offered.
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
# Optional, public. Publishable key (pk_test_..., same mode as STRIPE_SECRET_KEY): owners add a card
# in the Billing page with Stripe Elements. Empty: adding a card happens in Stripe's portal.
STRIPE_PUBLISHABLE_KEY=
# Optional, both or none. Extra storage past a paid plan's: the price id of the metered monthly price
# extra GB are billed at, and the event name of the Stripe meter behind it (aggregation: last). None:
# a plan's storage is a hard cap.
STRIPE_PRICE_STORAGE=
STRIPE_STORAGE_METER_EVENT=

# --- Optional ---
# "true" sends Expo push notifications to members with no app open.
EXPO_PUSH_ENABLED=false
# Secret. Only if your Expo project enforces push security.
EXPO_ACCESS_TOKEN=
# Sentry DSN. Empty keeps error reporting off. Events are scrubbed of mail content, addresses
# and credentials; their environment tag is ENVIRONMENT.
SENTRY_DSN=

# --- Domain Connect (docs/domain-connect/) ---
# Optional. The providerId our templates are published under. Empty hides "Set up automatically".
DOMAIN_CONNECT_PROVIDER_ID=
# Optional. Host of the TXT record with our public key, for templates that require signing.
DOMAIN_CONNECT_KEY_HOST=
# Secret, optional. PKCS#8 PEM private key that signs apply URLs (with DOMAIN_CONNECT_KEY_HOST).
DOMAIN_CONNECT_PRIVATE_KEY=

# DNS-over-HTTPS (JSON) resolver the image proxy uses to refuse private addresses.
IMAGE_PROXY_DOH_URL=https://cloudflare-dns.com/dns-query
# Sender avatars. An icon service for company logos ({domain} is replaced) and Gravatar for
# webmail senders ({hash} is the address's SHA-256). Empty uses the default; "off" skips one.
SENDER_LOGO_ICON_SERVICE=
SENDER_LOGO_GRAVATAR=
# production (default), development or test. Only "test" allows test-only switches.
# "development" also prints magic-link and invitation URLs to the wrangler dev console
# ({"event":"auth.dev_link",...}), so local sign-in needs no trip to GreenMail. Never set it in
# production: those URLs sign you in.
ENVIRONMENT=development
# Test-only. One origin exempt from the image proxy's address checks. The Worker refuses to
# start with it unless ENVIRONMENT=test.
IMAGE_PROXY_TEST_ALLOW_ORIGIN=

# Rate limits as "<count>/<seconds>" or "off"; empty uses the default in wrangler.jsonc. See
# docs/self-hosting.md (Rate limits).
RATE_LIMIT_AUTH=
RATE_LIMIT_MAGIC_LINK=
RATE_LIMIT_INVITE=
RATE_LIMIT_SEARCH=
RATE_LIMIT_SEND=
RATE_LIMIT_ACTIONS=
RATE_LIMIT_PROVISION=
RATE_LIMIT_IMAGE_PROXY=
RATE_LIMIT_STORAGE_SHARE=
RATE_LIMIT_STORAGE_SHARE_NEW=
RATE_LIMIT_STORAGE_LINK=
RATE_LIMIT_STORAGE_LINK_PASSWORD=
RATE_LIMIT_STORAGE_LINK_LIVE=
RATE_LIMIT_STORAGE_LINK_COMMENT=
RATE_LIMIT_STORAGE_SYNC=

# --- E2E tests only (`pnpm --filter @omni/worker test:e2e`) ---
# Admin URL of the local Postgres; each test file creates and drops its own database.
# DATABASE_URL=postgres://postgres:postgres@localhost:54329/omni
