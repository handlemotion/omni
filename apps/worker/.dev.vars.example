# apps/worker local config. Copy to `.dev.vars` (read by `wrangler dev`); in production set vars
# in wrangler.jsonc or the dashboard and secrets with `wrangler secret put <NAME>`.
# Hyperdrive needs no variable locally: wrangler.jsonc's `localConnectionString` points at the
# local stack's Postgres. Override it with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.

# --- Auth (Better Auth; see packages/auth/.env.example) ---
# Secret. At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this Worker (serves /api/auth).
BETTER_AUTH_URL=http://localhost:8787
# Comma-separated web/app origins allowed to call auth endpoints.
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Optional. WebAuthn relying party ID; defaults to the BETTER_AUTH_URL host.
AUTH_PASSKEY_RP_ID=
# Optional. Name shown in passkey prompts and magic-link mail. Defaults to "Omni".
APP_NAME=Omni
# Optional. Web app origin; invitation emails link to <WEB_APP_URL>/invite/<id>. Defaults to
# BETTER_AUTH_URL (the Worker serves the web app on the same origin). Locally, Vite's origin.
WEB_APP_URL=http://localhost:5173
# Optional. Google OAuth client ("Web application" type, Google Cloud console). Set both to show
# "Sign in with Google"; leave both empty to hide it. Authorized redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
# Secret.
GOOGLE_CLIENT_SECRET=
# Optional. Who may sign up (ADR 0018): "open" (default: anyone with a verified email signs up and
# creates their own workspace in onboarding) or "invitation" (a private install: sign-up needs a
# pending invitation, and only owners create workspaces; the first comes from
# `pnpm --filter @omni/db org:create`).
SIGN_UP=

# --- Mail service ---
# Base URL of apps/mail. The Worker pings it after writing to the outbox.
MAIL_SERVICE_URL=http://localhost:8788
# Secret. Signs Worker <-> mail service calls; same value as the mail service's.
# Generate: openssl rand -hex 32
MAIL_SERVICE_HMAC_SECRET=
# Address magic links, invitations and notices come from, sent with Cloudflare Email Sending
# (its domain onboarded there; `wrangler dev` only simulates it). Leave empty to disable email sign-in.
SYSTEM_MAIL_FROM=

# --- AI ---
# Secret. Summaries, and triage when TYPESAFE_API_KEY is empty. With neither key, threads stay
# unsorted (only a wordless reply from you files itself, as FYI).
ANTHROPIC_API_KEY=
# Secret. TypeSafe key: triage runs on Jev when set (summaries stay on Claude), and search
# results are reordered by Jev's relevance judgment. Empty: search keeps full-text order.
TYPESAFE_API_KEY=
# Optional. "jev" or "claude"; defaults to Jev when TYPESAFE_API_KEY is set.
TRIAGE_PROVIDER=
# Optional. Jev model override.
JEV_MODEL=
# Optional. TypeSafe API base URL. Defaults to https://api.typesafe.ai.
TYPESAFE_API_URL=
# Tokens per org per UTC day. Over the cap, summaries pause and triage keeps running.
AI_DAILY_TOKEN_CAP=1000000

# --- Billing (optional, ADR 0015; docs/self-hosting.md "Billing") ---
# Leave STRIPE_SECRET_KEY empty for no billing: no plan, no limits. Set it (test mode, sk_test_...)
# and the three marked "required" below must be set too, or the Worker will not start.
# Secret. Stripe secret key.
STRIPE_SECRET_KEY=
# Secret, required. Signing secret of the webhook endpoint (locally: `stripe listen` prints it).
STRIPE_WEBHOOK_SECRET=
# Required. Price id of the plan's monthly price. Amounts are set in Stripe, not here.
STRIPE_PRICE_MONTHLY=
# Optional. Price id of the yearly price. Empty offers monthly only.
STRIPE_PRICE_YEARLY=
# Optional, public. Publishable key (pk_test_..., same mode as STRIPE_SECRET_KEY): owners add a card
# in the Billing page with Stripe Elements. Empty: adding a card happens in Stripe's portal.
STRIPE_PUBLISHABLE_KEY=
# Optional. Free trial days, once per workspace and once per account, no card needed. Empty or 0: no trial.
BILLING_TRIAL_DAYS=
# Required. AI-triaged emails per workspace per month. Past it, triage pauses until the next period.
BILLING_TRIAGE_ALLOWANCE=

# --- Optional ---
# "true" sends Expo push notifications to members with no app open.
EXPO_PUSH_ENABLED=false
# Secret. Only if your Expo project enforces push security.
EXPO_ACCESS_TOKEN=
# Sentry DSN. Empty keeps error reporting off. Events are scrubbed of mail content, addresses
# and credentials; their environment tag is ENVIRONMENT.
SENTRY_DSN=

# --- Domain Connect (ADR 0011, docs/domain-connect/) ---
# Optional. The providerId our templates are published under. Empty hides "Set up automatically".
DOMAIN_CONNECT_PROVIDER_ID=
# Optional. Host of the TXT record with our public key, for templates that require signing.
DOMAIN_CONNECT_KEY_HOST=
# Secret, optional. PKCS#8 PEM private key that signs apply URLs (with DOMAIN_CONNECT_KEY_HOST).
DOMAIN_CONNECT_PRIVATE_KEY=

# DNS-over-HTTPS (JSON) resolver the image proxy uses to refuse private addresses.
IMAGE_PROXY_DOH_URL=https://cloudflare-dns.com/dns-query
# production (default), development or test. Only "test" allows test-only switches.
# "development" also prints magic-link and invitation URLs to the wrangler dev console
# ({"event":"auth.dev_link",...}), so local sign-in needs no trip to GreenMail. Never set it in
# production: those URLs sign you in.
ENVIRONMENT=development
# Test-only. One origin exempt from the image proxy's address checks. The Worker refuses to
# start with it unless ENVIRONMENT=test.
IMAGE_PROXY_TEST_ALLOW_ORIGIN=

# Rate limits as "<count>/<seconds>" or "off"; empty uses the default in wrangler.jsonc. See
# docs/self-hosting.md (Rate limits).
RATE_LIMIT_AUTH=
RATE_LIMIT_MAGIC_LINK=
RATE_LIMIT_INVITE=
RATE_LIMIT_SEARCH=
RATE_LIMIT_SEND=
RATE_LIMIT_ACTIONS=
RATE_LIMIT_PROVISION=
RATE_LIMIT_IMAGE_PROXY=

# --- E2E tests only (`pnpm --filter @omni/worker test:e2e`) ---
# Admin URL of the local Postgres; each test file creates and drops its own database.
# DATABASE_URL=postgres://postgres:postgres@localhost:54329/omni
