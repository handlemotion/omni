{
  "name": "@omni/worker",
  "private": true,
  "description": "Cloudflare Worker: Hono API, AI queue consumer, realtime Durable Object",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "doppler run -p omni -c dev_worker --mount .dev.vars --format env -- wrangler dev",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false && oxfmt worker-configuration.d.ts",
    "test:e2e": "vitest run --config vitest.e2e.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@omni/ai": "workspace:*",
    "@omni/auth": "workspace:*",
    "@omni/contracts": "workspace:*",
    "@omni/crypto": "workspace:*",
    "@omni/db": "workspace:*",
    "@omni/mail-core": "workspace:*",
    "@sentry/cloudflare": "^11.10.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "postgres": "^4.0.0",
    "stripe": "^22.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@hono/node-server": "^2.1.5",
    "@omni/mail": "workspace:*",
    "@types/dns-packet": "^5.6.5",
    "@types/nodemailer": "^8.0.2",
    "aws4fetch": "1.0.20",
    "better-auth": "^1.7.14",
    "dns-packet": "5.6.1",
    "imapflow": "^2.10.0",
    "nodemailer": "^10.3.1",
    "wrangler": "^4.156.0"
  }
}
