    "@omni/contracts": "workspace:*",
    "@omni/crypto": "workspace:*",
    "@omni/db": "workspace:*",
    "@omni/mail-core": "workspace:*",
    "@sentry/cloudflare": "^11.10.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "postgres": "^3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "wrangler": "^4.156.0"
  }
