// The one Omni Worker. Every value here is a neutral default; self-hosters change names and ids
// in this file and set secrets with `wrangler secret put` (see docs/self-hosting.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omni",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Production vars and secrets set in the dashboard or by CI survive deploys.
  "keep_vars": true,
  "observability": { "enabled": true },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "AUTH_TRUSTED_ORIGINS": "http://localhost:5173",
    "AUTH_PASSKEY_RP_ID": "",
    "APP_NAME": "Omni",
    "MAIL_SERVICE_URL": "http://localhost:8788",
    "SYSTEM_MAIL_FROM": "",
    "SENTRY_DSN": "",
    "AI_DAILY_TOKEN_CAP": "1000000",
    "TRIAGE_PROVIDER": "",
    "JEV_MODEL": "",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace with the id from `wrangler hyperdrive create omni --connection-string=...`.
      "id": "00000000000000000000000000000000",
      // `wrangler dev` and the e2e suites connect straight to the local stack's Postgres.
      "localConnectionString": "postgres://postgres:postgres@localhost:54329/omni",
    },
  ],
  // Raw messages and attachments, written by the mail service; the Worker only reads.
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "omni-mail",
      "preview_bucket_name": "omni-mail-dev",
    },
  ],
  // AI jobs: the Worker produces them on new mail and consumes them itself.
  "queues": {
    "producers": [{ "binding": "AI_QUEUE", "queue": "omni-ai" }],
    "consumers": [
      {
        "queue": "omni-ai",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "omni-ai-dlq",
      },
    ],
  },
  "durable_objects": {
    "bindings": [{ "name": "REPLAY_GUARD", "class_name": "ReplayGuard" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReplayGuard"] }],
}
