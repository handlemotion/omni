// The one Omni Worker. Every value here is a neutral default; self-hosters change names and ids
// in this file and set secrets with `wrangler secret put` (see docs/self-hosting.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omni",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Production vars and secrets set in the dashboard or by CI survive deploys.
  "keep_vars": true,
  "observability": { "enabled": true },
  // The web app (apps/web) is served from here, on the same origin as the API. Wrangler builds it
  // before `dev` and `deploy`. The Worker runs first only for its own paths; every other path is
  // a file from the build, or index.html so client-side routes deep-link.
  "build": { "command": "pnpm --filter @omni/web build", "watch_dir": "../web/src" },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/internal/*"],
  },
  "vars": {
    // `test` only in the e2e suites; it unlocks test-only switches.
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "AUTH_TRUSTED_ORIGINS": "http://localhost:5173",
    "AUTH_PASSKEY_RP_ID": "",
    "APP_NAME": "Omni",
    // Web app origin for invitation links; empty means the same origin as BETTER_AUTH_URL.
    "WEB_APP_URL": "",
    // Who may create a workspace in the app: "owners" (empty means this) or "anyone" signed in.
    "ORGANIZATION_CREATION": "",
    "MAIL_SERVICE_URL": "http://localhost:8788",
    "SYSTEM_MAIL_FROM": "",
    "SENTRY_DSN": "",
    "AI_DAILY_TOKEN_CAP": "1000000",
    "TRIAGE_PROVIDER": "",
    "JEV_MODEL": "",
    "TYPESAFE_API_URL": "",
    "EXPO_PUSH_ENABLED": "false",
    // Billing (ADR 0015). Off unless the STRIPE_SECRET_KEY secret is set; then the monthly price
    // id and the allowance are required. Amounts live in Stripe; these are ids and numbers only.
    "STRIPE_PRICE_MONTHLY": "",
    "STRIPE_PRICE_YEARLY": "",
    // Public: Stripe.js needs it to add a card in the Billing page. Empty: cards are added in the portal.
    "STRIPE_PUBLISHABLE_KEY": "",
    "BILLING_TRIAL_DAYS": "",
    "BILLING_TRIAGE_ALLOWANCE": "",
    "IMAGE_PROXY_DOH_URL": "https://cloudflare-dns.com/dns-query",
    // Rate limits as "<count>/<seconds>", or "off". Empty means the default shown. Sign-in steps
    // count per IP; magic links per address; invitations per inviting user; the rest per member.
    "RATE_LIMIT_AUTH": "60/60",
    "RATE_LIMIT_MAGIC_LINK": "5/900",
    "RATE_LIMIT_INVITE": "30/3600",
    "RATE_LIMIT_SEARCH": "60/60",
    "RATE_LIMIT_SEND": "100/3600",
    "RATE_LIMIT_ACTIONS": "300/60",
    "RATE_LIMIT_PROVISION": "30/3600",
    "RATE_LIMIT_IMAGE_PROXY": "300/60",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace with the id from `wrangler hyperdrive create omni --connection-string=...`.
      "id": "00000000000000000000000000000000",
      // `wrangler dev` and the e2e suites connect straight to the local stack's Postgres.
      "localConnectionString": "postgres://postgres:postgres@localhost:54329/omni",
    },
  ],
  // Raw messages and attachments, written by the mail service and read by the Worker. The Worker
  // also writes profile pictures and workspace logos under `pictures/` (src/routes/pictures.ts).
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "omni-mail",
      "preview_bucket_name": "omni-mail-dev",
    },
  ],
  // AI jobs: the Worker produces them on new mail and consumes them itself. Jobs that use up
  // their retries go to the DLQ, whose consumer (also this Worker) records them in
  // `dead_letters`. `max_retries` must match AI_QUEUE_MAX_RETRIES in src/queue.ts.
  "queues": {
    "producers": [{ "binding": "AI_QUEUE", "queue": "omni-ai" }],
    "consumers": [
      {
        "queue": "omni-ai",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "omni-ai-dlq",
      },
      { "queue": "omni-ai-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 10 },
    ],
  },
  // Per-org limits on domain setup (ADR 0010). `namespace_id` is any number unique in the
  // account; `period` is 10 or 60 seconds.
  "ratelimits": [
    {
      "name": "DOMAIN_ADD_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "DOMAIN_CHECK_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  // Every 6 hours: re-checks every verified domain's ownership record; a lost one pauses sending
  // (ADR 0010). Daily: reads every workspace's subscriptions back from Stripe (ADR 0015; nothing
  // with billing off), and deletes accounts that never joined or created a workspace and sat
  // unused for 30 days. The daily one must match DAILY_CRON in src/index.ts.
  "triggers": { "crons": ["23 */6 * * *", "47 3 * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "REPLAY_GUARD", "class_name": "ReplayGuard" },
      { "name": "REALTIME", "class_name": "Realtime" },
      { "name": "DOMAIN_WATCH", "class_name": "DomainWatch" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReplayGuard", "Realtime"] },
    // Auto-checks a domain's DNS while its setup page is open (ADR 0011).
    { "tag": "v2", "new_sqlite_classes": ["DomainWatch"] },
    // Rate limits on abuse-prone routes (src/rate-limiter.ts).
    { "tag": "v3", "new_sqlite_classes": ["RateLimiter"] },
  ],
}
