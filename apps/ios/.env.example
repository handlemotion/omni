# The Worker's public origin (BETTER_AUTH_URL): the API and sign-in. On a phone this must be
# reachable from the phone, e.g. the HTTPS URL `pnpm share` prints for a local stack.
EXPO_PUBLIC_OMNI_API_URL=http://localhost:8787
# Optional. The app's URL scheme (default `omni`). Add `<scheme>://` to the Worker's
# AUTH_TRUSTED_ORIGINS so magic links can hand the session back to the app.
OMNI_IOS_SCHEME=
# Optional. App name and bundle identifier for your own build.
OMNI_IOS_NAME=
OMNI_IOS_BUNDLE_ID=
# Release builds (scripts/release-testflight.sh). The version people see, the build number (one
# higher on every upload), and the Apple team that signs it.
OMNI_IOS_VERSION=
OMNI_IOS_BUILD_NUMBER=
OMNI_IOS_TEAM_ID=
