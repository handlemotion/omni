# The Worker's public origin (BETTER_AUTH_URL): the API and sign-in. On a phone this must be
# reachable from the phone, e.g. the HTTPS URL `pnpm share` prints for a local stack.
EXPO_PUBLIC_OMNI_API_URL=http://localhost:8787
# Optional. The app's URL scheme (default `omni`). Add `<scheme>://` to the Worker's
# AUTH_TRUSTED_ORIGINS so magic links can hand the session back to the app.
OMNI_IOS_SCHEME=
# Optional. App name and bundle identifier for your own build.
OMNI_IOS_NAME=
OMNI_IOS_BUNDLE_ID=
# Optional. The Worker's host (e.g. omnidirectional.app): its Drive share links (/s/<id>) open in
# the app. Needs the Associated Domains capability on the app ID and its profile, and the Worker's
# IOS_APP_IDS set to <team id>.<bundle id>. Unset, links open in Safari; omni://s/<id> still works.
OMNI_IOS_LINK_HOST=
# Release builds (scripts/release-testflight.sh). The version people see, the build number (one
# higher on every upload), and the Apple team that signs it.
OMNI_IOS_VERSION=
OMNI_IOS_BUILD_NUMBER=
OMNI_IOS_TEAM_ID=
# Optional: Sentry. Unset keeps error and crash reporting off. The DSN ships in the app (Sentry
# DSNs are public by design). Events are scrubbed of mail content and addresses before they leave.
EXPO_PUBLIC_SENTRY_DSN=
# Sentry environment tag; defaults to production.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Optional: upload source maps and debug symbols to Sentry during release builds. All three are
# needed; SENTRY_AUTH_TOKEN is a credential: inject it, never commit it.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_IOS_PROJECT=
