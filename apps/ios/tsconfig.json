{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".tsbuild",
    "lib": ["es2024", "dom"],
    "jsx": "react-jsx",
    "customConditions": ["react-native"],
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "app.config.ts", "expo-env.d.ts", "package.json"],
  // The Worker's route types reach the app through `@omni/client`.
  "references": [
    { "path": "../../packages/client/tsconfig.src.json" },
    // The worst-case layout suite (`e2e/`), against Node and the page.
    { "path": "./tsconfig.e2e.json" }
  ]
}
