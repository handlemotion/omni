{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".tsbuild",
    "types": ["node"],
    // Node runs src/*.ts directly in dev (type stripping); the image runs a bundle (see Dockerfile).
    "allowImportingTsExtensions": true
  },
  // vitest*.mts import the root vitest.shared.mts, which sits outside this project's rootDir.
  "include": ["src", "e2e"]
}
