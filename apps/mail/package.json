{
  "name": "@omni/mail",
  "private": true,
  "description": "Always-on mail service: ImapFlow IDLE, CONDSTORE sync, outbox, SMTP",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "doppler run -p omni -c dev_mail -- node --watch src/main.ts",
    "start": "node src/main.ts",
    "build": "node build.mjs",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.mts",
    "mailbox:add": "node src/cli/mailbox-add.ts",
    "dead-letters": "node src/cli/dead-letters.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@omni/contracts": "workspace:*",
    "@omni/crypto": "workspace:*",
    "@omni/db": "workspace:*",
    "@omni/mail-core": "workspace:*",
    "@sentry/node": "^11.10.0",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "imapflow": "^2.10.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2"
  }
}
