# apps/mail configuration. Copy to `.env` (read on startup) or set these in your container host.
# Variables already present in the environment take precedence over `.env`.

# HTTP port for /health and /ping. 8788 locally, because the Worker's `wrangler dev` uses 8787.
PORT=8788
# debug | info | warn | error. Logs are JSON lines on stdout.
LOG_LEVEL=info

# Optional: Sentry DSN. Unset keeps error reporting off. Events are scrubbed of mail content,
# addresses and credentials before they are sent; every `error` log line becomes an event.
# SENTRY_DSN=
# Sentry environment tag. Default production.
# SENTRY_ENVIRONMENT=production

# Shared secret for signed calls both ways (at least 32 characters): the Worker's pings to this
# service, and this service's mail events to the Worker. Must match the Worker's
# MAIL_SERVICE_HMAC_SECRET. Generate: openssl rand -hex 32
MAIL_SERVICE_HMAC_SECRET=

# Base URL of the Worker. New mail is reported to <WORKER_URL>/internal/mail-events.
WORKER_URL=http://localhost:8787

# Postgres the service indexes mail into (same database the Worker reads through Hyperdrive).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/omni

# Keyring that encrypts mailbox credentials at rest (AES-256-GCM): `<keyId>:<base64 of 32 bytes>`,
# comma-separated, current key first, e.g. `k2:<new>,k1:<old>` while rotating.
# Only this service may hold it. Generate a key: echo "k1:$(openssl rand -base64 32)"
MAIL_CREDENTIALS_KEY=

# S3-compatible bucket for raw mail, sanitized HTML and attachments. Production: Cloudflare R2
# (endpoint https://<account-id>.r2.cloudflarestorage.com, an R2 API token's key pair, region auto).
# Values below match the local gateway from `pnpm stack:up`.
S3_ENDPOINT=http://localhost:7070
S3_BUCKET=omni-mail-dev
S3_ACCESS_KEY_ID=omni-local
S3_SECRET_ACCESS_KEY=omni-local-secret
S3_REGION=auto

# Worker routes that stored HTML links to: the image proxy and inline (cid:) attachments.
IMAGE_PROXY_URL=/api/image-proxy
ATTACHMENT_URL=/api/attachments

# Optional: Purelymail admin API token (Purelymail → Account → API). Set, the web app's onboarding
# adds domains, users and app passwords on that account, and `mailbox:add --create-app-password`
# works. Unset, onboarding adds existing IMAP/SMTP logins instead. Only this service may hold it.
# PURELYMAIL_API_TOKEN=
# With the token: below this prepaid credit (US dollars), the service logs `hosting.credit_low` as an
# error and /health reports hostCredit "low". Purelymail stops mail when credit runs out.
# PURELYMAIL_CREDIT_WARN_USD=5
# Optional: Google OAuth client, so people can connect a Gmail account. Set both or
# neither. The Worker's sign-in client works; its consent screen must list the
# https://mail.google.com/ scope, and calendar.events.readonly with the Google Calendar API
# enabled for the account's Google Calendar. Only this service exchanges codes and holds Gmail
# tokens.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# A Google account indexes mail from this many days before it was connected, and everything that
# arrives after. Older mail stays in Gmail. 0 indexes the whole account (slow on a large one).
# Raising it later brings the older mail in on the next sync. Default 7.
# GMAIL_SYNC_DAYS=7

# Optional, for `mailbox:add`: where to send a signed ping so a running service connects the new
# mailbox at once.
# MAIL_SERVICE_URL=http://localhost:8788

# How often non-inbox folders are synced (INBOX is live over IDLE). Default 5 minutes.
SYNC_INTERVAL_MS=300000
# How often the outbox is polled when no ping arrives. Default 30 seconds.
OUTBOX_INTERVAL_MS=30000
# How often new-mail events the Worker never accepted (it was down, or this service crashed) are
# sent again. Default 1 minute.
NOTIFY_SWEEP_MS=60000
# Mailboxes connecting or syncing at the same time.
MAILBOX_CONCURRENCY=4

# Optional. Comma-separated hosts a mailbox may reach without encryption: on a non-TLS port
# (143, 587) every other host must upgrade with STARTTLS. Loopback (localhost) always may.
# MAIL_ALLOW_PLAINTEXT_HOSTS=
# Optional. Comma-separated hosts a member's own IMAP/SMTP login may use although they resolve to
# a private, loopback or link-local address. Unset refuses them all. The local stack (GreenMail)
# needs localhost; never list it on a shared server.
# MAIL_ALLOW_PRIVATE_HOSTS=localhost

# --- Domain verification ---
# Optional. Recursive resolvers used to find a domain's nameservers, comma-separated `ip` or
# `ip:port`. Empty uses the system's. Records are then read from those nameservers directly.
DNS_RESOLVERS=
# Optional. Port nameservers are asked on. Keep 53; only a local test DNS server needs another.
DNS_NAMESERVER_PORT=53
# Optional. Per-query timeout in milliseconds.
DNS_TIMEOUT_MS=2000

# E2E tests only (`pnpm --filter @omni/mail test:e2e`); defaults match `pnpm stack:up`.
# GREENMAIL_HOST=localhost
# GREENMAIL_IMAP_PORT=3143
# GREENMAIL_SMTP_PORT=3025
