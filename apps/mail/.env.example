# apps/mail configuration. Copy to `.env` (read on startup) or set these in your container host.
# Variables already present in the environment take precedence over `.env`.

# HTTP port for /health and /ping. 8788 locally, because the Worker's `wrangler dev` uses 8787.
PORT=8788
# debug | info | warn | error
LOG_LEVEL=info

# Shared secret the Worker uses to sign its pings to this service (at least 32 characters).
# Must match the Worker's MAIL_SERVICE_HMAC_SECRET. Generate: openssl rand -hex 32
MAIL_SERVICE_HMAC_SECRET=

# Postgres the service indexes mail into (same database the Worker reads through Hyperdrive).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/omni

# Keyring that encrypts mailbox credentials at rest (AES-256-GCM): `<keyId>:<base64 of 32 bytes>`,
# comma-separated, current key first, e.g. `k2:<new>,k1:<old>` while rotating.
# Only this service may hold it. Generate a key: echo "k1:$(openssl rand -base64 32)"
MAIL_CREDENTIALS_KEY=

# S3-compatible bucket for raw mail, sanitized HTML and attachments. Production: Cloudflare R2
# (endpoint https://<account-id>.r2.cloudflarestorage.com, an R2 API token's key pair, region auto).
# Values below match the local gateway from `pnpm stack:up`.
S3_ENDPOINT=http://localhost:7070
S3_BUCKET=omni-mail-dev
S3_ACCESS_KEY_ID=omni-local
S3_SECRET_ACCESS_KEY=omni-local-secret
S3_REGION=auto

# Worker routes that stored HTML links to: the image proxy and inline (cid:) attachments.
IMAGE_PROXY_URL=/api/image-proxy
ATTACHMENT_URL=/api/attachments

# How often non-inbox folders are synced (INBOX is live over IDLE). Default 5 minutes.
SYNC_INTERVAL_MS=300000
# How often the outbox is polled when no ping arrives. Default 30 seconds.
OUTBOX_INTERVAL_MS=30000
# Mailboxes connecting or syncing at the same time.
MAILBOX_CONCURRENCY=4

# E2E tests only (`pnpm --filter @omni/mail test:e2e`); defaults match `pnpm stack:up`.
# GREENMAIL_HOST=localhost
# GREENMAIL_IMAP_PORT=3143
# GREENMAIL_SMTP_PORT=3025
