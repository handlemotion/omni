{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.wrangler/**",
    "**/migrations/**",
    "fixtures/eml/**",
    "docs/spec/**",
    "**/CHANGELOG.md",
    "apps/desktop/src-tauri/tauri.conf.json",
    "pnpm-lock.yaml",
    "**/routeTree.gen.ts",
    ".claude/skills/typesafe-ai/**",
    ".claude/skills/gh-stack/references/**",
    ".claude/skills/hairline-*/**",
    ".agents/skills/hairline-*/**",
    ".claude/skills/sticky/**",
    ".agents/skills/sticky/**"
  ]
}
