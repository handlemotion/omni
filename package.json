{
  "name": "@omni/monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/handlemotion/omni"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --ui=tui",
    "dev:stack": "node scripts/dev-stack.mjs",
    "check": "oxfmt --check . && oxlint . && pnpm check:policies",
    "check:policies": "node scripts/check-tests.mjs && node scripts/check-workflows.mjs && node scripts/check-modules.mjs && node packages/contracts/scripts/native-types.ts --check && node --test scripts/",
    "check-types": "bun check --build --no-script --no-pretty",
    "fix": "oxfmt . && oxlint --fix .",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test": "turbo run test --affected",
    "test:all": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:local:up": "docker compose up -d --wait postgres",
    "db:local:down": "docker compose down",
    "mail:local:up": "docker compose up -d --wait greenmail",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down",
    "stack:serve": "node scripts/serve.mjs start",
    "stack:serve:stop": "node scripts/serve.mjs stop",
    "ios:dev": "apps/ios/scripts/dev.sh",
    "share": "node scripts/share.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@interfere/landmines": "0.0.0",
    "@types/node": "^26.6.6",
    "bun": "1.4.4",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "turbo": "^2.11.11",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1"
}
