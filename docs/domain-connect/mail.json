{
  "providerId": "omnidirectional.app",
  "providerName": "Omni",
  "serviceId": "mail",
  "serviceName": "Omni mail on Purelymail",
  "version": 1,
  "logoUrl": "https://inbox.omnidirectional.app/apple-touch-icon.png",
  "description": "Proves the domain belongs to your Omni workspace and points its mail at Purelymail.",
  "variableDescription": "challenge: the token after omni-challenge= in Omni's ownership value. ownership: the part after purelymail_ownership_proof= in the Purelymail account's ownership code.",
  "syncBlock": false,
  "syncPubKeyDomain": "omnidirectional.app",
  "syncRedirectDomain": "inbox.omnidirectional.app",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "_omni-challenge",
      "data": "omni-challenge=%challenge%",
      "ttl": 300,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "omni-challenge="
    },
    {
      "type": "TXT",
      "host": "@",
      "data": "purelymail_ownership_proof=%ownership%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "purelymail_ownership_proof="
    },
    {
      "type": "MX",
      "host": "@",
      "pointsTo": "mailserver.purelymail.com",
      "priority": 50,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:_spf.purelymail.com"
    },
    {
      "type": "CNAME",
      "host": "purelymail1._domainkey",
      "pointsTo": "key1.dkimroot.purelymail.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "purelymail2._domainkey",
      "pointsTo": "key2.dkimroot.purelymail.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "purelymail3._domainkey",
      "pointsTo": "key3.dkimroot.purelymail.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "_dmarc",
      "pointsTo": "dmarcroot.purelymail.com",
      "ttl": 3600,
      "essential": "OnApply"
    }
  ]
}
