# Read by parseAuthEnv() in the process that serves auth (the Worker: put these in
# apps/worker/.dev.vars locally, Worker secrets/vars in production).

# Random string, at least 32 characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public origin of the API that serves /api/auth.
BETTER_AUTH_URL=http://localhost:8787
# Optional. Comma-separated origins allowed to call auth endpoints: the web app, and the iOS
# app's scheme `omni://` so OAuth callbacks hand the session back to the app.
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Optional. WebAuthn relying party ID (your app's registrable domain). Defaults to the
# BETTER_AUTH_URL host.
AUTH_PASSKEY_RP_ID=
# Optional. Name shown in passkey prompts. Defaults to "Omni".
APP_NAME=
# Optional. Web app origin; invitation emails link to <WEB_APP_URL>/invite/<id>. Defaults to
# BETTER_AUTH_URL.
WEB_APP_URL=
# Optional. Google OAuth client; set both or neither. Neither hides "Sign in with Google".
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
# Secret.
GOOGLE_CLIENT_SECRET=
# Optional. Apple OAuth client; set both or neither. Neither hides "Sign in with Apple".
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/apple.
APPLE_CLIENT_ID=
# Secret (JWT signed with your Apple Sign In private key).
APPLE_CLIENT_SECRET=
# Optional. Native iOS app bundle ID for native Sign in with Apple (e.g. app.omnidirectional.ios).
APPLE_APP_BUNDLE_IDENTIFIER=
# Optional. Who may sign up: "open" (default: anyone with a verified email signs up and
# creates their own workspace) or "invitation" (a private install: sign-up needs a pending
# invitation, and only owners create workspaces; the first comes from
# `pnpm --filter @omni/db org:create`).
SIGN_UP=
# Optional: hosts whose OAuth client metadata documents agents may connect with over MCP,
# comma separated. Empty: Claude's and ChatGPT's (claude.ai, chatgpt.com). Other
# MCP clients register dynamically.
MCP_CIMD_HOSTS=
# Optional billing. Empty STRIPE_SECRET_KEY: no Stripe plugin, no plan, no limits.
# With it set, STRIPE_WEBHOOK_SECRET and STRIPE_PRICE_MONTHLY (Team monthly) are required.
# What each plan allows is PLAN_LIMITS in packages/contracts/src/plans.ts.
# Secret.
STRIPE_SECRET_KEY=
# Secret.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Optional: the Business plan's prices. Empty monthly: Business is not offered.
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
# Optional, public (pk_test_… / pk_live_…, same mode as the secret key). Lets owners add a card in
# the app's Billing page (Stripe Elements); empty sends them to Stripe's portal for that.
STRIPE_PUBLISHABLE_KEY=
# Optional: free trial days, once per workspace and per account. Empty: 7. 0: no trial.
BILLING_TRIAL_DAYS=
# Optional, both or none: the metered price for extra GB past a paid plan's storage, and the
# event name of its Stripe meter.
STRIPE_PRICE_STORAGE=
STRIPE_STORAGE_METER_EVENT=
