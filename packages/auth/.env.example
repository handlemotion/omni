# Read by parseAuthEnv() in the process that serves auth (the Worker: put these in
# apps/worker/.dev.vars locally, Worker secrets/vars in production).

# Random string, at least 32 characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public origin of the API that serves /api/auth.
BETTER_AUTH_URL=http://localhost:8787
# Optional. Comma-separated origins (web app, Expo) allowed to call auth endpoints.
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Optional. WebAuthn relying party ID (your app's registrable domain). Defaults to the
# BETTER_AUTH_URL host.
AUTH_PASSKEY_RP_ID=
# Optional. Name shown in passkey prompts. Defaults to "Omni".
APP_NAME=
# Optional. Web app origin; invitation emails link to <WEB_APP_URL>/invite/<id>. Defaults to
# BETTER_AUTH_URL.
WEB_APP_URL=
# Optional. Google OAuth client; set both or neither. Neither hides "Sign in with Google".
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
# Secret.
GOOGLE_CLIENT_SECRET=
# Optional. Who may sign up (ADR 0018): "open" (default: anyone with a verified email signs up and
# creates their own workspace) or "invitation" (a private install: sign-up needs a pending
# invitation, and only owners create workspaces; the first comes from
# `pnpm --filter @omni/db org:create`).
SIGN_UP=
# Optional billing (ADR 0015). Empty STRIPE_SECRET_KEY: no Stripe plugin, no plan, no limits.
# With it set, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_MONTHLY and BILLING_TRIAGE_ALLOWANCE are required.
# Secret.
STRIPE_SECRET_KEY=
# Secret.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Optional, public (pk_test_… / pk_live_…, same mode as the secret key). Lets owners add a card in
# the app's Billing page (Stripe Elements); empty sends them to Stripe's portal for that.
STRIPE_PUBLISHABLE_KEY=
BILLING_TRIAL_DAYS=
BILLING_TRIAGE_ALLOWANCE=
