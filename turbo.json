{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["DOPPLER_TOKEN", "CI", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      // Unit suites read the shared config and the repo-level fixtures; editing either must
      // rerun them instead of replaying a cached pass.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.mts", "$TURBO_ROOT$/fixtures/**"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "GREENMAIL_*", "ANTHROPIC_API_KEY"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    }
  }
}
