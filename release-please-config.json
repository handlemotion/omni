    { "type": "revert", "section": "Reverts" }
  ],
  "packages": {
    "apps/desktop": {
      "component": "desktop",
      "release-type": "node",
      "package-name": "@omni/desktop",
      "extra-files": [
        { "type": "json", "path": "src-tauri/tauri.conf.json", "jsonpath": "$.version" }
      ]
    },
    "apps/ios": {
      "component": "ios",
      "release-type": "node",
      "package-name": "@omni/ios"
    }
  }
}
